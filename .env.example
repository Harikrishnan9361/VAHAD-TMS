# ====================================================================
# Django settings
# ====================================================================
DJANGO_SECRET_KEY=your-django-production-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# ====================================================================
# Database credentials (MySQL)
# ====================================================================
DB_NAME=your_mysql_db_name
DB_USER=your_mysql_db_user
DB_PASSWORD=your_mysql_db_password
DB_HOST=your_mysql_db_host
DB_PORT=3306

# ====================================================================
# Vahad Travel Assistant - LLM Configuration Keys
# ====================================================================
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: LangSmith API configuration for tracing and debugging
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=vahad-assistant
